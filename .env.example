APP_NAME=CompressPix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=compresspix
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Set SITE_INDEXABLE=true only on the public production site. Run `php artisan site:launch-check` before launch.
SITE_INDEXABLE=false
SITE_BRAND="CompressPix"
SITE_TAGLINE="Free online image compressor"

# Operator identity (shown on About, Contact, legal pages and in structured data). Leave empty until known.
SITE_COMPANY_NAME="CompressPix"
SITE_COUNTRY=
SITE_FOUNDING_YEAR=
SITE_HOSTING_PROVIDER=
SITE_JURISDICTION=
SITE_CONTACT_RETENTION=
SITE_LOG_RETENTION=
SITE_TWITTER_HANDLE=
SITE_SOCIAL_TWITTER=
SITE_SOCIAL_FACEBOOK=
SITE_SOCIAL_LINKEDIN=
SITE_SOCIAL_GITHUB=

CONTACT_NOTIFY_EMAIL=
CONTACT_SEND_MAIL=false

ANALYTICS_GA4_ID=

COMPRESSOR_MAX_UPLOAD_MB=20
COMPRESSOR_MAX_PIXELS=50000000
COMPRESSOR_SERVER_MAX_PIXELS=25000000
COMPRESSOR_DEFAULT_QUALITY=80
COMPRESSOR_RATE_LIMIT_PER_MINUTE=30
